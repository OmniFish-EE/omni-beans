<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ee.omnifish</groupId>
        <artifactId>omnibeans-parent</artifactId>
        <version>0.4-SNAPSHOT</version>
    </parent>

    <artifactId>test-pom</artifactId>
    <packaging>pom</packaging>

    <name>OmniBeans Test Parent</name>

    <!-- The transaction module is only built with the piranha profile, the security module with the quarkus one -->
    <modules>
        <module>async</module>
        <module>singleton</module>
        <module>exceptions</module>
        <module>transactions</module>
        <module>interceptors</module>
        <module>locking</module>
        <module>injection</module>
        <module>discovery</module>
    </modules>

    <properties>
        <!-- The tests are not deployed -->
        <maven.deploy.skip>true</maven.deploy.skip>

        <jakartaee.version>11.0.0</jakartaee.version>
        <piranha.version>25.4.0-SNAPSHOT</piranha.version>
        <arquillian-quarkus.version>1.1.1</arquillian-quarkus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Test dependencies. -->
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>1.10.2.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>${jakartaee.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- OmniFaces dependencies. -->
        <dependency>
            <groupId>ee.omnifish</groupId>
            <artifactId>omnibeans</artifactId>
        </dependency>

        <dependency>
            <groupId>org.omnifaces</groupId>
            <artifactId>omniservices</artifactId>
        </dependency>

        <!-- Test dependencies. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.jboss.arquillian.junit5</groupId>
            <artifactId>arquillian-junit5-container</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.htmlunit</groupId>
            <artifactId>htmlunit</artifactId>
            <version>5.6.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Quarkus. OmniBeans and OmniServices are loaded from the local Maven repository: run "mvn install" -->
        <profile>
            <id>quarkus</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <!-- Needs Exousia's Quarkus extension, and a RunAsHandler, which Piranha doesn't have yet -->
                <module>security</module>
            </modules>
            <dependencies>
                <dependency>
                    <groupId>ee.omnifish.arquillian</groupId>
                    <artifactId>arquillian-quarkus-managed</artifactId>
                    <version>${arquillian-quarkus.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <arquillian.quarkus.dependencies>
                                    io.quarkus:quarkus-undertow,
                                    io.quarkus:quarkus-narayana-jta,
                                    io.quarkus:quarkus-smallrye-context-propagation,
                                    ee.omnifish:omnibeans:${project.version},
                                    org.omnifaces:omniservices:${omniservices.version},
                                    jakarta.ejb:jakarta.ejb-api:${jakarta.ejb-api.version},
                                    jakarta.authorization:jakarta.authorization-api:${jakarta.authorization-api.version}
                                </arquillian.quarkus.dependencies>
                                <!-- Quarkus rejects @jakarta.ejb.Singleton unless this check is off -->
                                <arquillian.quarkus.buildProperties>quarkus.arc.detect-wrong-annotations=false</arquillian.quarkus.buildProperties>
                                <!-- ArC intercepts calls on this, Weld doesn't (TransactionsTest.selfInvocation) -->
                                <omnibeans.test.selfInvocationIntercepted>true</omnibeans.test.selfInvocationIntercepted>
                                <!-- Quarkus creates servlets as beans, Piranha from their unmodified class (InjectionTest) -->
                                <omnibeans.test.servletEjbInjected>true</omnibeans.test.servletEjbInjected>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Piranha Micro, in process. Until they're upstream, this needs a local Piranha build with the fixes of branch
            weld-early-start, without which @Transactional doesn't work.
        -->
        <profile>
            <id>piranha</id>
            <modules>
                <!-- Needs Jakarta Persistence -->
                <module>transaction</module>
            </modules>
            <dependencies>
                <dependency>
                    <groupId>cloud.piranha.arquillian</groupId>
                    <artifactId>piranha-arquillian-server</artifactId>
                    <version>${piranha.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.jboss.shrinkwrap.resolver</groupId>
                    <artifactId>shrinkwrap-resolver-depchain</artifactId>
                    <version>3.3.7</version>
                    <type>pom</type>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <piranha.offline>true</piranha.offline>
                                <piranha.rootIsWarName>true</piranha.rootIsWarName>
                                <!-- Replaces the OmniBeans and OmniServices versions that Micro comes with -->
                                <piranha.dependencies>ee.omnifish:omnibeans:${project.version},org.omnifaces:omniservices:${omniservices.version}</piranha.dependencies>
                                <omnibeans.test.selfInvocationIntercepted>false</omnibeans.test.selfInvocationIntercepted>
                                <omnibeans.test.servletEjbInjected>false</omnibeans.test.servletEjbInjected>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
