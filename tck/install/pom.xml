<!-- Copied from the platform TCK's glassfish-runner/enterprise-beans-tck/enterprise-beans-tck-install -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ee.omnifish</groupId>
        <artifactId>omnibeans-tck</artifactId>
        <version>0.4-SNAPSHOT</version>
    </parent>

    <artifactId>omnibeans-tck-install</artifactId>
    <packaging>pom</packaging>

    <name>OmniBeans - Jakarta Enterprise Beans TCK - Install</name>

    <properties>
        <tck.test.enterprise-beans.file>jakartaeetck-${tck.version}.zip</tck.test.enterprise-beans.file>
        <tck.test.enterprise-beans.url>https://download.eclipse.org/jakartaee/platform/11/${tck.test.enterprise-beans.file}</tck.test.enterprise-beans.url>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>io.github.download-maven-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>2.1.0</version>
                <configuration>
                    <url>${tck.test.enterprise-beans.url}</url>
                    <unpack>true</unpack>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>download-enterprise-beans-tck</id>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <phase>generate-resources</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-install-plugin</artifactId>
                <executions>
                    <execution>
                        <id>install-artifacts-bom</id>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <file>${project.build.directory}/jakartaeetck/artifacts/artifacts-bom-${tck.version}.pom</file>
                            <groupId>jakarta.tck</groupId>
                            <artifactId>ejb30</artifactId>
                            <version>${tck.version}</version>
                            <packaging>pom</packaging>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-enterprise-beans-tck-ejb30</id>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <file>${project.build.directory}/jakartaeetck/artifacts/ejb30-${tck.version}.jar</file>
                            <groupId>jakarta.tck</groupId>
                            <artifactId>ejb30</artifactId>
                            <version>${tck.version}</version>
                            <packaging>jar</packaging>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-enterprise-beans-tck-ejb32</id>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <file>${project.build.directory}/jakartaeetck/artifacts/ejb32-${tck.version}.jar</file>
                            <groupId>jakarta.tck</groupId>
                            <artifactId>ejb32</artifactId>
                            <version>${tck.version}</version>
                            <packaging>jar</packaging>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
