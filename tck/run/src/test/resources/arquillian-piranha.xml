<?xml version="1.0" encoding="UTF-8"?>
<!--
    Based on the platform TCK's glassfish-runner/enterprise-beans-tck arquillian.xml: the TCK's tests deploy to the
    container "tck-javatest", and run in their vehicle through the javatest protocol. The container is configured with
    system properties (see the POM).
-->
<arquillian xmlns="http://jboss.org/schema/arquillian" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <engine>
        <property name="deploymentExportPath">target/deployments</property>
    </engine>

    <container qualifier="tck-javatest" default="true">
        <protocol type="javatest">
            <property name="workDir">${ts.home}/tmp</property>
            <property name="tsJteFile">${ts.home}/bin/ts.jte</property>
            <property name="trace">true</property>
        </protocol>
    </container>
</arquillian>
